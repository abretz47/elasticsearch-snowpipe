# Elasticsearch Configuration
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_USE_SSL=true
ES_VERIFY_CERTS=true
# ES_CA_CERTS=/path/to/ca.crt
# ES_API_KEY=your_api_key_here
ES_INDEXES=logs-*,metrics-*,events-*

# Snowflake Configuration
SF_ACCOUNT=your_account.region
SF_USER=your_username
SF_PASSWORD=your_password
# SF_PRIVATE_KEY_PATH=/path/to/private_key.p8
# SF_PRIVATE_KEY_PASSPHRASE=your_passphrase
SF_DATABASE=ES_DATA
SF_SCHEMA=PUBLIC
SF_WAREHOUSE=COMPUTE_WH
# SF_ROLE=your_role
SF_TABLE_PREFIX=es_

# Application Configuration
BATCH_SIZE=1000
SYNC_INTERVAL=300
LOG_LEVEL=INFO
